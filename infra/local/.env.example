# LLM API Keys (optional when using local Ollama models)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com # Change if using a proxy
LITELLM_MASTER_KEY=sk-litellm-dev

# Host-served Ollama models. From Docker containers on macOS, localhost on the
# host is reachable as host.docker.internal.
OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=ollama/qwen8b:latest
OLLAMA_QWEN_MODEL=ollama/qwen8b:latest
OLLAMA_GEMMA_MODEL=ollama/gemma4:latest
OLLAMA_EMBEDDING_MODEL=ollama/nomic-embed-text

# Platform Configuration
NEXT_PUBLIC_TENANT_ID=default-tenant

# Service URLs (Local Docker Networking)
# These are typically handled by docker-compose internally, 
# but can be overridden here for host-based development.
# LLM_GATEWAY_URL=http://localhost:4000/v1
# LITELLM_BASE_URL=http://localhost:4000/v1
